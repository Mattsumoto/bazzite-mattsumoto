# Build parameters for the custom Bazzite image.

# Read by `just image_name` and used by build.yml to tag the published image.
# The -nvidia-open suffix is load-bearing: Bazzite's live-session hardware
# helper (on_gui_login.sh) classifies the payload by NAME, and anything without
# it is treated as an AMD/Intel image, producing a spurious WRONG IMAGE DETECTED
# warning on NVIDIA hardware. The name is accurate - this is a
# bazzite-nvidia-open derivative - so it is a fix, not a workaround.
IMAGE_NAME=bazzite-mattsumoto-nvidia-open

# GitHub username or organisation that owns the repo.
REPO_ORGANIZATION="mattsumoto"

IMAGE_DESC="Bazzite (NVIDIA open) with hardware fixes for ASUS ROG STRIX X570-F / Ryzen 7 5800X / RTX 3080 / Samsung Odyssey OLED G9 / ASUS PCE-AC88"
IMAGE_KEYWORDS="bootc,bazzite,nvidia,x570,odyssey-g9,bcm4366"

IMAGE_LOGO_URL="https://avatars.githubusercontent.com/u/120078124?s=200&v=4"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
